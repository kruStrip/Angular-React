        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: 'qwen2.5:3b',\n  stream: false,\n  format: {\n    type: 'object',\n    properties: {\n      category: { type: 'string', enum: ['Сантехника', 'Электрика', 'Мебель', 'Интернет'] },\n      urgent: { type: 'boolean' },\n      summary: { type: 'string' }\n    },\n    required: ['category', 'urgent', 'summary']\n  },\n  messages: [\n    { role: 'system', content: 'Ты диспетчер коменданта общежития колледжа. По заявке жильца определи категорию (Сантехника, Электрика, Мебель, Интернет), срочность и напиши краткое описание до 12 слов. Срочно — если течёт вода или есть риск затопления, искрит проводка или пахнет гарью, нет света или интернета у целого этажа или есть риск для безопасности. Отвечай только JSON.' },\n    { role: 'user', content: 'Что случилось: ' + $json.body.title + '\\nКомната: ' + $json.body.room + '\\nКатегория от автора: ' + $json.body.category + '\\nПодробности: ' + $json.body.details }\n  ]\n} }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Модель",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
